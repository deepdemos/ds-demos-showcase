# 复制成仓库根的 .env 再改：`cp deploy/docker/env.example .env`
#
# .env 已在 .gitignore 里（不能提交口令）。这里的值只是**占位**，
# 真实部署必须换掉——尤其是三个 secret，换法见文件末尾。

# 数据库口令：compose 会用它初始化 postgres，也会拼进 api 的 DATABASE_URL
POSTGRES_DB=deepdemos
POSTGRES_USER=deepdemos
POSTGRES_PASSWORD=change-me

# 对外的 http 端口（nginx）。80 需要 root 或额外配置，默认 8080。
WEB_PORT=8080

# 两个必须自己生成的密钥：
#   IP_HASH_SECRET         匿名访客 IP 的 HMAC 密钥（浏览去重、评分去重都靠它）
#   VERIFICATION_SECRET    邮箱验证码的 HMAC 密钥；缺了它 API 会直接退出
#
# 生成：
#   openssl rand -base64 32
# 多实例部署时这两个密钥必须一致，否则 A 实例发的验证码 B 实例验不过。
IP_HASH_SECRET=change-me-please-32-bytes
VERIFICATION_SECRET={{SECRET_g7nlm2ve}}

# CSRF：log = 只记日志放行（观察期），enforce = 拦下跨站写请求。
# 先跑 log，确认日志里没有正常的跨站写请求，再切 enforce。
CSRF_MODE=log

# 模型目录（models.dev）。留空用默认地址；内网部署可以指向镜像源。
MODEL_CATALOG_URL=

# 邮件：不配时验证码只写日志（开发用）。生产必须配 SMTP，否则用户收不到验证码。
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 1 = 把验证码打进日志（仅开发）。生产必须为 0。
MAIL_LOG_CODES=0


# ── TLS（可选，只有起 `--profile tls` 时才用得上）────────────────────────────
# 浏览器登录要求 https：会话 cookie 是 __Host- + Secure，http 下浏览器根本不存。
# 所以要让人用浏览器登进来，把下面打开：
#
#   DOMAIN=你的域名        # 必须是实际访问的地址：证书按它签发，SNI 也必须对上
#   docker compose --profile tls up -d
#
# 本地/内网自签（没有真域名时）：额外设置
#   CADDYFILE=deploy/docker/Caddyfile.internal
# 根证书从容器导出后 curl 用 --cacert 认它：
#   docker compose cp caddy:/data/caddy/pki/authorities/local/root.crt ./caddy-root.crt

# DOMAIN=deepdemos.example.com
# ACME_EMAIL=ops@example.com
# CADDYFILE=deploy/docker/Caddyfile
# 生产用 80/443；开发机上 80 常被占用，可以换个端口
# TLS_HTTP_PORT=80
# TLS_HTTPS_PORT=443