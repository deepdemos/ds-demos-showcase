{
  "_说明": "每个端点的反例：它必须拒绝什么，以及哪条测试钉住这件事。校验器是 scripts/check-negative-cases.mjs，CI 在 file-size job 里跑。加端点不写反例 = 门禁红。",
  "endpoints": {
    "GET /healthz": [
      {
        "case": "数据库连不上时响应体不能泄露连接串或内部错误文本",
        "test": {
          "file": "backend/internal/httpapi/handlers_test.go",
          "name": "TestHealthzDatabaseDownDoesNotLeak"
        }
      }
    ],
    "GET /api/v1/demos": [
      {
        "case": "pageSize 超过上限返回 400，不静默截断成上限值",
        "test": {
          "file": "backend/internal/httpapi/handlers_test.go",
          "name": "TestListDemosRejectsOversizedPageSize"
        }
      },
      {
        "case": "搜索词超过 100 个字回 400，不静默截断",
        "test": {
          "file": "backend/internal/httpapi/search_integration_test.go",
          "name": "TestIntegrationSearchDemos"
        }
      },
      {
        "case": "搜不到时返回空列表而不是全部作品",
        "test": {
          "file": "backend/internal/httpapi/search_integration_test.go",
          "name": "TestIntegrationSearchDemos"
        }
      }
    ],
    "POST /api/v1/demos": [
      {
        "case": "未登录投稿返回 401，且不建出任何作品行",
        "test": {
          "file": "backend/internal/httpapi/demos_submit_integration_test.go",
          "name": "TestIntegrationSubmitRequiresLogin"
        }
      },
      {
        "case": "声明的模型不存在或未启用 → 400，且文案点出是哪个（不静默丢掉）",
        "test": {
          "file": "backend/internal/httpapi/models_integration_test.go",
          "name": "TestIntegrationSubmitDeclaresModels"
        }
      },
      {
        "case": "幂等键超过 128 个字符回 400，不静默截断（截断等于把两次调用并成一次）",
        "test": {
          "file": "backend/internal/httpapi/submit_idempotency_integration_test.go",
          "name": "TestIntegrationSubmitRejectsLongIdempotencyKey"
        }
      },
      {
        "case": "同一个幂等键重复投稿回 200（重放），不是 201——201 等于说又建了一条",
        "test": {
          "file": "backend/internal/httpapi/submit_idempotency_integration_test.go",
          "name": "TestIntegrationSubmitIsIdempotent"
        }
      }
    ],
    "GET /api/v1/demos/{slug}": [
      {
        "case": "渠道为 hidden 的作品对匿名访问者 404（列表之外也不能直链读到）",
        "test": {
          "file": "backend/internal/httpapi/handlers_test.go",
          "name": "TestGetDemoHiddenChannelIs404"
        }
      }
    ],
    "POST /api/v1/auth/register": [
      {
        "case": "邮箱已存在返回 409，不建出第二个账号",
        "test": {
          "file": "backend/internal/httpapi/integration_test.go",
          "name": "TestIntegrationRegister"
        }
      }
    ],
    "POST /api/v1/auth/login": [
      {
        "case": "连续失败到阈值后要求邮箱验证码，而不是继续允许猜口令",
        "test": {
          "file": "backend/internal/httpapi/integration_test.go",
          "name": "TestIntegrationLoginRateLimit"
        }
      }
    ],
    "POST /api/v1/auth/email-code": [
      {
        "case": "同一 IP 每小时配额用完后拒绝发码",
        "test": {
          "file": "backend/internal/domain/identity/integration_test.go",
          "name": "TestIntegrationEmailCodeIPQuota"
        }
      }
    ],
    "POST /api/v1/auth/password-reset/code": [
      {
        "case": "不存在的账号也回 204，不泄露账号是否存在",
        "test": {
          "file": "backend/internal/domain/identity/integration_test.go",
          "name": "TestIntegration不存在的账号也发码但不下发"
        }
      }
    ],
    "POST /api/v1/auth/password-reset": [
      {
        "case": "验证码不对时不改密码，旧口令仍然可用",
        "test": {
          "file": "backend/internal/domain/identity/integration_test.go",
          "name": "TestIntegrationPasswordReset"
        }
      }
    ],
    "POST /api/v1/auth/logout": [
      {
        "case": "登出后旧 cookie 立刻失效，重复登出仍然 204",
        "test": {
          "file": "backend/internal/httpapi/integration_test.go",
          "name": "TestIntegrationLoginLogout"
        }
      }
    ],
    "GET /api/v1/me": [
      {
        "case": "没有会话 cookie 时 401，不返回空身份当成功",
        "test": {
          "file": "backend/internal/httpapi/integration_test.go",
          "name": "TestIntegrationGetMe"
        }
      }
    ],
    "POST /api/v1/auth/verify-email": [
      {
        "case": "验证码不对时报错，且账号仍是 pending（不能靠猜码激活）",
        "test": {
          "file": "backend/internal/domain/identity/integration_test.go",
          "name": "TestIntegrationVerifyEmailRejectsBadCode"
        }
      }
    ],
    "POST /api/v1/auth/verify-email/resend": [
      {
        "case": "已验证或不存在的邮箱也回 204，重发不泄露账号状态",
        "test": {
          "file": "backend/internal/httpapi/verifyemail_integration_test.go",
          "name": "TestIntegrationVerifyResendAlwaysNoContent"
        }
      }
    ],
    "GET /api/v1/admin/reviews/demo": [
      {
        "case": "没有 demo.review 权限的用户 403，不返回待审列表",
        "test": {
          "file": "backend/internal/httpapi/reviews_integration_test.go",
          "name": "TestIntegrationReviewPermission"
        }
      }
    ],
    "POST /api/v1/admin/reviews/demo/{slug}": [
      {
        "case": "decision 不在 approve/reject 枚举里返回 400，不能落成驳回",
        "test": {
          "file": "backend/internal/httpapi/reviews_integration_test.go",
          "name": "TestIntegrationReviewRejectsUnknownDecision"
        }
      }
    ],
    "POST /api/v1/admin/demos/{slug}/publish": [
      {
        "case": "没有发布权限的用户 403",
        "test": {
          "file": "backend/internal/httpapi/publish_integration_test.go",
          "name": "TestIntegrationPublishPermission"
        }
      }
    ],
    "PUT /api/v1/demos/{slug}": [
      {
        "case": "未登录更新作品返回 401，且不改任何版本",
        "test": {
          "file": "backend/internal/httpapi/update_integration_test.go",
          "name": "TestIntegrationUpdateDemo"
        }
      },
      {
        "case": "别人的作品返回 404（不区分「不存在」与「不是你的」，避免泄露 slug）",
        "test": {
          "file": "backend/internal/httpapi/update_integration_test.go",
          "name": "TestIntegrationUpdateDemo"
        }
      },
      {
        "case": "不带新包却改作品类型返回 400",
        "test": {
          "file": "backend/internal/httpapi/update_integration_test.go",
          "name": "TestIntegrationUpdateDemo"
        }
      },
      {
        "case": "路由必须挂在 PUT 上，写成 POST 会让生成的客户端调不通",
        "test": {
          "file": "backend/internal/httpapi/update_integration_test.go",
          "name": "TestIntegrationUpdateDemoRouteUsesPUT"
        }
      }
    ],
    "GET /api/v1/demos/{slug}/revisions": [
      {
        "case": "未登录看版本列表返回 401，不是 404",
        "test": {
          "file": "backend/internal/httpapi/revisions_integration_test.go",
          "name": "TestIntegrationListRevisionsHTTP"
        }
      },
      {
        "case": "非作者且无审核权一律 404（不承认 slug 存在）",
        "test": {
          "file": "backend/internal/httpapi/revisions_integration_test.go",
          "name": "TestIntegrationListRevisionsHTTP"
        }
      }
    ],
    "POST /api/v1/demos/{slug}/revisions/{revNo}/restore": [
      {
        "case": "非作者回滚别人的作品返回 404",
        "test": {
          "file": "backend/internal/domain/demo/revisions_integration_test.go",
          "name": "TestIntegrationRestoreRejectsOthers"
        }
      },
      {
        "case": "回滚到当前版本返回 400（不白造一个同内容版本）",
        "test": {
          "file": "backend/internal/domain/demo/revisions_integration_test.go",
          "name": "TestIntegrationRestoreKeepsCurrentIsRejected"
        }
      },
      {
        "case": "目标版本已擦除返回 404",
        "test": {
          "file": "backend/internal/domain/demo/revisions_integration_test.go",
          "name": "TestIntegrationRestoreRejectsErasedRevision"
        }
      },
      {
        "case": "版本号不是正整数返回 400，不存在的版本 404",
        "test": {
          "file": "backend/internal/httpapi/revisions_integration_test.go",
          "name": "TestIntegrationRestoreRevisionHTTP"
        }
      }
    ],
    "POST /api/v1/demos/{slug}/archive": [
      {
        "case": "非作者不能下架别人的作品（连存在性都不透露）",
        "test": {
          "file": "backend/internal/httpapi/lifecycle_integration_test.go",
          "name": "TestIntegrationLifecycleRejectsStrangers"
        }
      },
      {
        "case": "未登录不能下架，返回 401 而不是悄悄成功",
        "test": {
          "file": "backend/internal/httpapi/lifecycle_integration_test.go",
          "name": "TestIntegrationLifecycleRejectsStrangers"
        }
      }
    ],
    "POST /api/v1/demos/{slug}/unarchive": [
      {
        "case": "只对已下架的作品有效，已发布的再上架是冲突",
        "test": {
          "file": "backend/internal/domain/demo/lifecycle_integration_test.go",
          "name": "TestIntegrationArchiveAndUnarchive"
        }
      },
      {
        "case": "未登录不能重新上架",
        "test": {
          "file": "backend/internal/httpapi/lifecycle_integration_test.go",
          "name": "TestIntegrationLifecycleRejectsStrangers"
        }
      }
    ],
    "POST /api/v1/demos/{slug}/restore": [
      {
        "case": "恢复窗口一过就不能恢复",
        "test": {
          "file": "backend/internal/domain/demo/lifecycle_integration_test.go",
          "name": "TestIntegrationRestoreWindowClosed"
        }
      },
      {
        "case": "没被删过的作品不能恢复",
        "test": {
          "file": "backend/internal/domain/demo/lifecycle_integration_test.go",
          "name": "TestIntegrationDeleteRejectsTwice"
        }
      }
    ],
    "DELETE /api/v1/demos/{slug}": [
      {
        "case": "重复删除是冲突，不是幂等成功",
        "test": {
          "file": "backend/internal/domain/demo/lifecycle_integration_test.go",
          "name": "TestIntegrationDeleteRejectsTwice"
        }
      },
      {
        "case": "被平台移除的作品作者不能自己删",
        "test": {
          "file": "backend/internal/domain/demo/lifecycle_integration_test.go",
          "name": "TestIntegrationSoftDeleteRejectsRemoved"
        }
      }
    ],
    "POST /api/v1/demos/{slug}/view": [
      {
        "case": "作品不存在也返回 204，不暴露 slug 是否存在",
        "test": {
          "file": "backend/internal/httpapi/views_integration_test.go",
          "name": "TestIntegrationPostDemoView"
        }
      },
      {
        "case": "未发布的作品不计入浏览数",
        "test": {
          "file": "backend/internal/domain/demo/view_integration_test.go",
          "name": "TestIntegrationRecordViewSkipsUnpublished"
        }
      },
      {
        "case": "同一人同一天重复浏览不重复计数",
        "test": {
          "file": "backend/internal/domain/demo/view_integration_test.go",
          "name": "TestIntegrationRecordViewDedupesPerDay"
        }
      }
    ],
    "GET /api/v1/models": [
      {
        "case": "候选模型不出现在模型目录里（目录是投稿表单的选项来源）",
        "test": {
          "file": "backend/internal/httpapi/models_integration_test.go",
          "name": "TestIntegrationListActiveModels"
        }
      },
      {
        "case": "目录为空时 items 是 [] 而不是 null，前端不必特判",
        "test": {
          "file": "backend/internal/httpapi/models_integration_test.go",
          "name": "TestIntegrationListActiveModels"
        }
      }
    ]
  },
  "outsideContract": {
    "GET /preview/{slug}/*": [
      {
        "case": "渠道为 hidden 的作品对匿名访问者 404（未发布/未审过同样拒绝）",
        "test": {
          "file": "backend/internal/httpapi/preview_integration_test.go",
          "name": "TestIntegrationPreviewVisibility"
        }
      }
    ],
    "GET /download/{slug}": [
      {
        "case": "渠道为 hidden 的作品 404，且不给外链作品造假的包",
        "test": {
          "file": "backend/internal/httpapi/download_integration_test.go",
          "name": "TestIntegrationDownload"
        }
      }
    ]
  }
}
