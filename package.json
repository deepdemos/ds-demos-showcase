{
  "name": "ds-demos-showcase-tools",
  "version": "0.0.0",
  "private": true,
  "description": "仓库级门禁与真库校验脚本（不含业务代码；前端依赖在 web/ 下单独管理）",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "verify:schema": "node scripts/verify-schema.mjs",
    "gen:api:go": "cd api && oapi-codegen -config oapi-codegen.yaml openapi.yaml",
    "gen:api:web": "npx --yes orval@8.46.0 --config web/orval.config.ts",
    "gen:api": "npm run gen:api:go && npm run gen:api:web",
    "check:api-compat": "node scripts/check-api-compat.mjs",
    "seal:api-compat": "node scripts/check-api-compat.mjs --update",
    "db:up": "cd backend && go run ./cmd/migrate up",
    "db:status": "cd backend && go run ./cmd/migrate status",
    "db:seed": "cd backend && go run ./cmd/migrate -mode seed",
    "db:seal": "node scripts/check-migrations.mjs --seal",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:layering": "node scripts/check-layering.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14"
  }
}
